{
  "name": "ultra-harddisk-defrag",
  "version": "1.0.0",
  "description": "Ultra Harddisk Defrag 1.0 - disk analysis and optimization suite (Windows defrag engine, TRIM, boot optimize, SMART health, scheduling)",
  "main": "./out/main/index.js",
  "author": "Ultra Harddisk Defrag",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "selftest": "tsx src/main/engine/selftest.ts",
    "dist": "electron-vite build && electron-builder --win --x64",
    "test:ipc": "node scripts/ipc-test.mjs",
    "test:window": "node scripts/window-test.mjs",
    "test": "npm run selftest",
    "shot": "node scripts/shot.mjs",
    "icon": "node scripts/make-icon.mjs && node scripts/make-ico.mjs",
    "pack": "electron-vite build && electron-builder --win --x64 --dir && node scripts/patch-exe.mjs",
    "dist:zip": "npm run pack && node scripts/make-zip.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
